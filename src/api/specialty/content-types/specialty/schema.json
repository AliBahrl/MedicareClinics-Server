{
  "kind": "collectionType",
  "collectionName": "specialties",
  "info": {
    "singularName": "specialty",
    "pluralName": "specialties",
    "displayName": "Specialty"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "doctors": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::doctor.doctor",
      "mappedBy": "specialty"
    },
    "description": {
      "type": "text"
    }
  }
}
